{
  "topic_summary": "本週探討AI如何透過大規模假帳號與深度偽造內容操縱資訊環境，進而威脅民主的共同事實基礎與制度信任；學生需從特定分析切入點構建可由公共理由支持的倫理論證，並檢視其最強反論、回應方式以及倫理價值的代價與個人立場的影響。",
  "rubrics": {
    "Q2": {
      "scoring_criteria": {
        "9-10": "P1、P2、C 三部分皆明確標示，事實前提具體且有可靠來源，規範前提闡明倫理原則，結論自然從兩前提推導，無顯著錯誤或跳躍。",
        "7-8": "三部分皆 present，但其中一部分稍嫌不夠具體或標示略有模糊，推導基本合理，偶有小疏漏。",
        "5-6": "基本包含 P1、P2、C，但其中一部分缺失或過於籠統，推導有跳躍或需加強說明。",
        "3-4": "缺少一個或多個部分，或標示混亂，事實前提缺乏具體依據，結論與前提關聯不明。",
        "0-2": "未能區分 P1/P2/C，或僅零散陳述，缺乏論證結構。"
      },
      "format_checklist": [
        "Contains P1 premise",
        "Contains P2 premise",
        "Contains C conclusion",
        "Each part clearly labeled (P1/P2/C)",
        "Logical flow from P1+P2 to C"
      ]
    },
    "Q3": {
      "scoring_criteria": {
        "9-10": "清楚指出具體反對點，直接針對P2或整體論證的薄弱環節，提供充分證據或例證，理由邏輯嚴謹且具建設性。",
        "7-8": "反對點明確，但證據或說明稍嫌不足，理由基本合理，偶有小幅偏離。",
        "5-6": "提出反對，但過於籠統或未緊扣論證，證據有限，推導略顯草率。",
        "3-4": "反對模糊、與論點無關或僅重複既有論點，缺乏實質理由。",
        "0-2": "未提出可辨識的反對，或僅發表無關感想。"
      },
      "format_checklist": [
        "States a clear objection",
        "References P2 or overall argument",
        "Provides reasoning or evidence"
      ]
    },
    "Q5": {
      "scoring_criteria": {
        "9-10": "明確選擇限定/堅持/修正/放棄其中一種，直接回應Q3反對，提供充分且合理的理由說明，顯示與原P2的一致性或必要調整。",
        "7-8": "選擇明確且回應反對，理由較為充分，但說明略欠深度或有小幅不一致。",
        "5-6": "給出回應類型，但對Q3的回應泛泛或理由不足，可能忽略部分關鍵點。",
        "3-4": "回應類型不明確或與Q3無關，理由極為簡略或矛盾。",
        "0-2": "未說明所選回應類型，或僅重複原論點而未回應反對。"
      },
      "format_checklist": [
        "States chosen response type (qualify/defend/revise/concede)",
        "Explains why that response is chosen",
        "Addresses the objection raised in Q3",
        "Shows consistency with or adjustment to P2"
      ]
    },
    "Q6": {
      "scoring_criteria": {
        "9-10": "清楚指出一項或多項倫理價值，具體描述其維護或實現所需的成本/犧牲，闡述得失權衡，並有理據或例證支持。",
        "7-8": "指出倫理價值與成本，說明具體但深度或證據略嫌不足，權衡討論基本完整。",
        "5-6": "提及倫理價值與成本，但描述過於籠統或僅單方面，缺少完整權衡分析。",
        "3-4": "僅提及價值或成本其中一方，或說明模糊缺乏具體內容。",
        "0-2": "未能辨識倫理價值與其成本，或內容與題目無關。"
      },
      "format_checklist": [
        "Identifies at least one ethical value",
        "Describes concrete cost or trade‑off",
        "Connects cost to the argument or value",
        "Provides evidence or rationale for the cost"
      ]
    },
    "Q7": {
      "scoring_criteria": {
        "9-10": "清楚闡述個人立場，詳細考慮具體情境因素（如文化、制度、資訊來源），展現深刻自我反思，並解釋這些因素如何共同塑造對議題的判斷。",
        "7-8": "說明立場與情境，反思深度適度，關聯性清晰但可能略欠具體例證。",
        "5-6": "提及立場與情境，但描述過於概括，反思有限，關聯性說明不足。",
        "3-4": "僅陳述立場或情境其中一方，缺乏對另一方的考量或反思。",
        "0-2": "未能區分立場與情境，或僅發表無關個人感想。"
      },
      "format_checklist": [
        "Reflects on personal stance",
        "Considers situational factors",
        "Explains impact on judgment",
        "Shows reflective depth"
      ]
    }
  },
